#!/usr/bin/env bash

# Update JavaScript packages and open and merge a pull request.

set -euo pipefail # exit on any error, don't allow undefined variables, pipes don't swallow errors

gfcob update-javascript-packages

yq -i 'del(.minimumReleaseAgeExclude)' pnpm-workspace.yaml
audit_exit_status=0
pnpm audit --fix=update || audit_exit_status=$?

if [[ "$audit_exit_status" -gt 1 ]]; then
  exit "$audit_exit_status"
fi

rm pnpm-lock.yaml
rm node_modules/.pnpm/lock.yaml

pnpm install
pnpm update --latest
pnpm install --no-frozen-lockfile
pnpm dedupe

# Check for any bump to a prerelease version.
if git diff -U0 -- package.json pnpm-workspace.yaml \
    | grep -E '^\+.*[0-9]+\.[0-9]+\.[0-9]+-[0-9A-Za-z]'; then
  red 'Prerelease version found in updated dependencies. Aborting.'
  exit 1
fi

gacm 'Update JavaScript packages'

yic

if uncommitted-changes-exist ; then
  red 'There are uncommitted changes. Not opening PR.'
  exit 1
else
  hwm
fi
